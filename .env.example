# Copy to .env (never committed) and fill in. Scripts read this file directly.

# Which profile folder under profiles/ to use (or a path such as examples/demo).
JOBSEARCH_PROFILE=examples/demo

# Your own Apify token: console.apify.com > Settings > API & Integrations.
APIFY_TOKEN=apify_api_PASTE_YOUR_TOKEN_HERE
# Your Apify username. Runs stop if the token belongs to another account.
APIFY_EXPECTED_USER=your-apify-username

# Only for /publish: the email you log in to Overleaf with.
OVERLEAF_EXPECTED_EMAIL=
